{
  "name": "dietclaw",
  "version": "0.3.1",
  "description": "Codebase health monitor. Find out why your project is getting fat.",
  "type": "module",
  "bin": {
    "dietclaw": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "assets",
    "CHANGELOG.md"
  ],
  "scripts": {
    "cli": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22.12 --packages=external --sourcemap --outfile=dist/cli.js \"--banner:js=#!/usr/bin/env node\"",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "keywords": [
    "cli",
    "codebase",
    "health",
    "bloat",
    "dependencies",
    "openclaw"
  ],
  "author": "psandis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/psandis/dietclaw.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "oxc-parser": "^0.153.0",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
